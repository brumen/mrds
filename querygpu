#! /usr/bin/env python
import subprocess
import time
from lxml import etree


class GPUCommunicationException(Exception):
    pass


def query_gpu():
    """ Query the working of the gpu. Prints out utilization
        and memory demands every second.
    """

    COMMAND_LINE = '/usr/bin/nvidia-smi'

    while True:
        try:
            # prints out the xml version
            out, err = subprocess.Popen(
                [COMMAND_LINE, "-q", "-x"],
                stdout=subprocess.PIPE
            ).communicate()

        except Exception as e:
            raise GPUCommunicationException(
                f'Could not connect to the nvidia card. Error: {e}.'
            )

        nvidia_xml = etree.fromstring(out)

        utilization_node = nvidia_xml.find('gpu/utilization/gpu_util')
        util_memory_node = nvidia_xml.find('gpu/utilization/memory_util')

        print(f'Utilization: {utilization_node.text}')
        print(f'Memory: {util_memory_node.text}')
        print("\033[12A")

        time.sleep(1)


query_gpu()
