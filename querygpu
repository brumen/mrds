#! /usr/bin/env python
import subprocess
import time


class GPUCommunicationException(Exception):
    pass


def query_gpu():
    """ Query the working of the gpu. Prints out utilization and memory demands every second.
    """

    COMMAND_LINE = '/usr/bin/nvidia-smi'

    # line 80 - Compute mode
    lines_to_print = range(70, 85)

    while True:
        try:
            out, err = subprocess.Popen( [COMMAND_LINE, "-q"], stdout=subprocess.PIPE )\
                                 .communicate()

        except Exception as e:
            raise GPUCommunicationException(f'Could not connect to the nvidia card. Error: {e}.')

        out_lines = out.decode().split('\n')

        print('\n'.join([out_lines[line_nb] for line_nb in lines_to_print]))
        print("\033[12A")

        time.sleep(1)


query_gpu()
